# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://monitoring:monitoring@localhost:5432/monitoring?schema=public"

# Redis connection used by BullMQ (scheduler -> queue -> worker)
REDIS_URL="redis://localhost:6379"

# JWT signing secret for API auth tokens
JWT_SECRET="change-me-in-production"

# API server port
PORT=4000

# SMTP settings for email alerts. If left unset, alert emails are logged to
# the console instead of sent, which is convenient for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERTS_FROM_EMAIL="alerts@monitoring.local"

# How often the scheduler polls for due monitors, in milliseconds
SCHEDULER_POLL_INTERVAL_MS=5000
